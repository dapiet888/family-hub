{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-hub",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "HOUSEHOLD", "class_name": "HouseholdBoard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HouseholdBoard"] }
  ]
}
